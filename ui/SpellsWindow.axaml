<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ui"
        x:Class="ui.SpellsWindow"
        Title="Sorts de combat" Width="900" Height="760"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BpBgBrush}" MinWidth="720" MinHeight="540"
        FontFamily="Inter, Segoe UI Variable Text, Segoe UI">

  <!-- Les icones sont celles du jeu (grimoire du serveur), converties une fois
       en PNG par spell_icons.py et lues dans data/spell_icons. -->

  <Window.Styles>
    <Style Selector="TextBlock.k">
      <Setter Property="Foreground" Value="{StaticResource BpFaintBrush}"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="LetterSpacing" Value="1.2"/>
    </Style>
    <Style Selector="TextBlock.sub">
      <Setter Property="Foreground" Value="{StaticResource BpMutedBrush}"/>
      <Setter Property="FontSize" Value="11.5"/>
    </Style>
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource BpPanelBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BpEdgeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="14"/>
    </Style>
    <!-- une ligne de sort : tuile sombre, icone, nom, details, actions -->
    <Style Selector="Border.row">
      <Setter Property="Background" Value="{StaticResource BpPanel2Brush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BpEdgeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="9"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style Selector="Border.ico">
      <Setter Property="Background" Value="{StaticResource BpBgBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BpEdgeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Width" Value="34"/>
      <Setter Property="Height" Value="34"/>
      <Setter Property="Padding" Value="2"/>
    </Style>
    <Style Selector="Button">
      <Setter Property="Background" Value="{StaticResource BpPanel3Brush}"/>
      <Setter Property="Foreground" Value="{StaticResource BpTextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BpEdgeBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="7"/>
      <Setter Property="Padding" Value="11,6"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource BpAccentDimBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BpAccentBrush}"/>
    </Style>
    <Style Selector="Button.tiny">
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Width" Value="25"/>
      <Setter Property="Height" Value="23"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="{StaticResource BpMutedBrush}"/>
    </Style>
    <Style Selector="Button.add">
      <Setter Property="Foreground" Value="{StaticResource BpAccentBrush}"/>
      <Setter Property="FontWeight" Value="Bold"/>
      <Setter Property="FontSize" Value="14"/>
    </Style>
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource BpBgBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource BpTextBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BpEdgeBrush}"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Padding" Value="9,6"/>
      <Setter Property="FontSize" Value="12.5"/>
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{StaticResource BpAccentBrush}"/>
    </Style>
    <Style Selector="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource BpTextBrush}"/>
      <Setter Property="MinHeight" Value="0"/>
    </Style>
    <!-- curseurs a la couleur de l'appli plutot qu'au bleu du systeme -->
    <Style Selector="Slider /template/ Thumb">
      <Setter Property="Background" Value="{StaticResource BpAccentBrush}"/>
    </Style>
    <Style Selector="Slider /template/ Border#TrackBackground">
      <Setter Property="Background" Value="{StaticResource BpEdgeBrush}"/>
    </Style>
    <Style Selector="Slider /template/ Rectangle#PART_SelectedRangeRectangle">
      <Setter Property="Fill" Value="{StaticResource BpAccentBrush}"/>
    </Style>
  </Window.Styles>

  <DockPanel Margin="16">

    <!-- l'ordre EST la priorité : on l'annonce avant tout le reste, c'est la
         seule chose que le joueur doit comprendre pour s'en servir -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12" Spacing="4">
      <TextBlock Classes="k" Text="PRIORITÉ DES SORTS"/>
      <TextBlock Classes="sub" TextWrapping="Wrap"
                 Text="Le premier sort de la liste qui a une cible valide est lancé. Le bot enchaîne tant qu'il lui reste des PA."/>
      <TextBlock x:Name="Warn" Foreground="{StaticResource BpWarnBrush}" FontSize="12"
                 TextWrapping="Wrap" Margin="0,4,0,0" IsVisible="False"/>
    </StackPanel>

    <!-- options tactiques -->
    <Border DockPanel.Dock="Bottom" Classes="card" Margin="0,12,0,0">
      <StackPanel Spacing="11">
        <TextBlock Classes="k" Text="COMPORTEMENT"/>
        <CheckBox x:Name="Move" Click="OnMove"
                  Content="Se rapprocher quand aucune cible n'est à portée"/>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="sub" Text="Délai entre deux actions"
                     VerticalAlignment="Center" Width="200"/>
          <Slider x:Name="Delay" Grid.Column="1" Minimum="10" Maximum="200"
                  TickFrequency="10" IsSnapToTickEnabled="True"
                  VerticalAlignment="Center" Margin="8,0"/>
          <TextBlock x:Name="DelayText" Grid.Column="2" Classes="sub" Width="62"
                     VerticalAlignment="Center" TextAlignment="Right"/>
        </Grid>
        <Grid ColumnDefinitions="Auto,*,Auto">
          <TextBlock Classes="sub" Text="Trajet max pour aller agresser"
                     VerticalAlignment="Center" Width="200"/>
          <Slider x:Name="Steps" Grid.Column="1" Minimum="1" Maximum="60"
                  TickFrequency="1" IsSnapToTickEnabled="True"
                  VerticalAlignment="Center" Margin="8,0"/>
          <TextBlock x:Name="StepsText" Grid.Column="2" Classes="sub" Width="62"
                     VerticalAlignment="Center" TextAlignment="Right"/>
        </Grid>
      </StackPanel>
    </Border>

    <Grid ColumnDefinitions="*,12,*">

      <!-- à gauche ce que le bot fera, à droite ce qu'on peut lui ajouter.
           L'ordre de priorité est le cœur du réglage : il prend la plus grande
           part, sinon la liste se retrouvait tronquée dès trois sorts. -->
      <Grid Grid.Column="0" RowDefinitions="2*,12,*">
        <Border Classes="card">
          <DockPanel>
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,9">
              <TextBlock Classes="k" Text="SORTS UTILISÉS" VerticalAlignment="Center"/>
              <Button Grid.Column="1" Classes="tiny" Width="74" Click="OnClear"
                      Content="Tout vider"/>
            </Grid>
            <TextBlock x:Name="EmptyPick" DockPanel.Dock="Top" Classes="sub"
                       TextWrapping="Wrap" IsVisible="False"
                       Text="Aucun sort choisi : le bot prend automatiquement les sorts offensifs appris, les plus coûteux en PA d'abord."/>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="Picked">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:PickRow">
                  <Border Classes="row" Opacity="{Binding Dim}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                      <TextBlock Text="{Binding Rank}"
                                 Foreground="{StaticResource BpAccentBrush}"
                                 FontWeight="Bold" Width="17" FontSize="13"
                                 VerticalAlignment="Center"/>
                      <Border Grid.Column="1" Classes="ico" Margin="0,0,9,0">
                        <Image Source="{Binding Icon}"/>
                      </Border>
                      <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Foreground="{Binding Colour}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Detail}" Classes="sub"
                                   TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="3"
                                  VerticalAlignment="Center">
                        <Button Classes="tiny" Content="↑" Command="{Binding Up}"
                                ToolTip.Tip="Monter dans la priorité"/>
                        <Button Classes="tiny" Content="↓" Command="{Binding Down}"
                                ToolTip.Tip="Descendre"/>
                        <Button Classes="tiny" Content="✕" Command="{Binding Remove}"
                                ToolTip.Tip="Retirer"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>

        <Border Grid.Row="2" Classes="card">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Classes="k" Margin="0,0,0,9"
                       Text="LANCÉS SUR SOI AU 1ᵉʳ TOUR"/>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <ItemsControl x:Name="Buffs">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:BuffRow">
                  <Border Classes="row" Opacity="{Binding Dim}" Padding="7,4">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                      <CheckBox IsChecked="{Binding On, Mode=OneWay}"
                                Command="{Binding Toggle}" VerticalAlignment="Center"
                                Margin="0,0,2,0"/>
                      <Border Grid.Column="1" Classes="ico" Width="27" Height="27"
                              Margin="0,0,8,0">
                        <Image Source="{Binding Icon}"/>
                      </Border>
                      <TextBlock Grid.Column="2" Text="{Binding Name}"
                                 Foreground="{Binding Colour}"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis"/>
                    </Grid>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </DockPanel>
        </Border>
      </Grid>

      <Border Grid.Column="2" Classes="card">
        <DockPanel>
          <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,9">
            <TextBlock Classes="k" Text="SORTS DISPONIBLES" VerticalAlignment="Center"/>
            <TextBlock x:Name="AvailCount" Grid.Column="1" Classes="sub"
                       VerticalAlignment="Center"/>
          </Grid>
          <TextBox x:Name="Search" DockPanel.Dock="Top" Margin="0,0,0,7"
                   PlaceholderText="Filtrer par nom…"/>
          <CheckBox x:Name="OnlyLearned" DockPanel.Dock="Top" Margin="0,0,0,9"
                    Click="OnFilter" Content="Uniquement les sorts appris"
                    Foreground="{StaticResource BpMutedBrush}" FontSize="12"/>
          <TextBlock x:Name="EmptyAvail" DockPanel.Dock="Top" Classes="sub"
                     TextWrapping="Wrap" IsVisible="False"
                     Text="Aucun sort connu. Connecte-toi et entre en combat une fois : le serveur envoie alors la liste, qui est ensuite mémorisée."/>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="Available">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="local:AvailRow">
                <Border Classes="row" Opacity="{Binding Dim}">
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <Border Classes="ico" Margin="0,0,9,0">
                      <Image Source="{Binding Icon}"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Foreground="{Binding Colour}"
                                 FontWeight="SemiBold"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding Detail}" Classes="sub"
                                 TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Button Grid.Column="2" Classes="tiny add" Content="+"
                            Command="{Binding Add}" VerticalAlignment="Center"
                            ToolTip.Tip="Ajouter à la liste de priorité"/>
                  </Grid>
                </Border>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
